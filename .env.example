# --- Payload CMS ---
# Long random string used to sign auth tokens. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# --- PostgreSQL (Railway) ---
# Connection string from your Railway Postgres plugin (Connect tab → Postgres Connection URL).
# Format: postgres://user:password@host:port/database
DATABASE_URI=

# --- Cloudflare R2 (S3-compatible) ---
# Bucket name (you create this in the R2 dashboard).
R2_BUCKET=
# R2 S3 API endpoint, looks like: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# R2 API token credentials (Manage R2 API Tokens → Create Token with Read/Write).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
